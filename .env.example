# Copy to .env.local and fill in. Also set these in AWS Amplify:
# App settings -> Environment variables.
#
# These are compiled into the public JavaScript bundle (anything prefixed
# VITE_ is). EmailJS IDs and the *public* key are designed to be public;
# never put an EmailJS private key or any other secret here.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
